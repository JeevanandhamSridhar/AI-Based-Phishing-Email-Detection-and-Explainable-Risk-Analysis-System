# AI-Based Phishing Email Detection & Explainable Risk Analysis System
# Environment Configuration Defaults

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Database
DATABASE_URL=sqlite:///./phishing_risk_analyzer.db

# Safety Invariants (Strict Defensive Isolation)
OFFLINE_ONLY=True
ALLOW_NETWORK_FETCH=False
ALLOW_ATTACHMENT_EXECUTION=False

# Configurable Risk Engine Weights (Sum = 100)
WEIGHT_ML_PHISHING=30
WEIGHT_URL_RISK=20
WEIGHT_HEADER_AUTH=15
WEIGHT_SENDER_DOMAIN=10
WEIGHT_SOCIAL_ENG=10
WEIGHT_ATTACHMENT=10
WEIGHT_CONTENT=5

# Categorical Risk Thresholds (Project-defined defaults, not universal standards)
THRESHOLD_LOW=25
THRESHOLD_MODERATE=50
THRESHOLD_HIGH=75

# File Storage
REPORTS_DIR=./reports/generated
MODELS_DIR=./models
DATA_DIR=./data
